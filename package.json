{
  "name": "beautinique-gateway",
  "version": "1.0.0",
  "description": "Beautinique Gateway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/generate-html.mjs",
    "dev": "concurrently -n \"TS,APP\" -c \"yellow,cyan\" \"tsc --noEmit --watch\" \"nodemon --watch src --ext ts --exec tsx src/index.ts\"",
    "start": "node dist/index.js",
    "start:dev": "npm run build && node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rmdir /s /q dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Nageshwar Pawar",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@beautinique/backend-types": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@beautinique/backend-classes": "^1.1.0",
    "@beautinique/backend-constants": "^1.1.0",
    "@beautinique/backend-cors": "^1.1.0",
    "@beautinique/backend-logger": "^1.1.0",
    "@beautinique/backend-request": "^1.1.0",
    "@beautinique/backend-response": "^1.1.0",
    "@beautinique/backend-utils": "^1.1.0",
    "@beautinique/backend-zod": "^1.1.0",
    "@beautinique/shared-markdown-to-html": "^1.1.0",
    "@beautinique/shared-utils": "^1.1.0",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique-Gateway.git"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique-Gateway.git#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique-Gateway.git/issues"
  },
  "optionalDependencies": {
    "pino-pretty": "^13.2.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true
  }
}
