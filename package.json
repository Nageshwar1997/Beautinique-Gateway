{
  "name": "beautinique-gateway",
  "version": "1.0.0",
  "description": "Beautinique Gateway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently -n \"TS,APP\" -c \"yellow,cyan\" \"tsc --noEmit --watch\" \"nodemon --watch src --ext ts --exec tsx src/index.ts\"",
    "start": "node dist/index.js",
    "start:dev": "npm run build && node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rmdir /s /q dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique-Gateway.git"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique-Gateway.git#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique-Gateway.git/issues"
  },
  "keywords": [],
  "author": "Nageshwar Pawar",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "@beautinique/be-classes": "^1.0.5",
    "@beautinique/be-constants": "^1.0.8",
    "@beautinique/be-middlewares": "^1.0.14",
    "@beautinique/be-utils": "^1.0.4",
    "@beautinique/be-zod": "^1.0.17",
    "axios": "^1.16.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.3"
  }
}
